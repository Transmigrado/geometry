rules_version = '2';

/**
 * Las fotos de perfil.
 *
 * Aquí sólo hay caras de adultos: los alumnos no suben ninguna, su avatar
 * es el muñeco 3D y su retrato se genera del propio lienzo. Eso es a
 * propósito —cuanto menos material de menores guardemos, mejor— y conviene
 * que siga así.
 */
service firebase.storage {
  match /b/{bucket}/o {

    match /fotos/{uid} {
      // La ve cualquiera que haya entrado, porque aparece en los listados
      // de profesores de un colegio.
      allow read: if request.auth != null;

      /**
       * Y la escribe sólo su dueño. El tamaño va limitado porque el
       * navegador ya la encoge a 256 píxeles antes de subirla: si llega
       * algo más grande, es que no pasó por ahí.
       */
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    /**
     * Las láminas del álbum. El mismo contenido para todos, así que lo lee
     * cualquiera que entró; la escritura es del Admin SDK, a mano, hasta
     * que exista un panel para subir colecciones nuevas.
     */
    match /cards/{collectionId}/{archivo} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
